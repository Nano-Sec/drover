#!/usr/bin/env python3
"""herd: run Claude subagents in visible herdr panes. See SKILL.md."""
import argparse, contextlib, fcntl, glob, json, os, re, shutil, subprocess, sys, time

MIN_PANE_W = 60  # smallest readable Claude pane, in terminal columns and rows
MIN_PANE_H = 14
MAX_COLS = 2     # subagent grid limits, which keep the splits even
MAX_ROWS = 4
MIN_SPLIT_WIDTH = 2 * MIN_PANE_W
ANY_STATE = ["working", "blocked", "done", "idle"]
MIN_PYTHON = (3, 9)
MIN_HERDR = (0, 8, 0)  # the oldest version herd has been tested against
FALLBACK_MODE = "manual"  # when auto is unavailable. Never bypassPermissions.
AUTO_REFUSED = re.compile(r"auto mode|'auto' is invalid", re.I)  # on the screen of a pane that exited
STATE_DIR = os.path.abspath(os.path.expanduser(os.environ.get("HERD_STATE_DIR") or "~/.claude/herd"))
PROJECTS_DIR = os.path.abspath(os.path.expanduser(os.environ.get("HERD_PROJECTS_DIR") or "~/.claude/projects"))
REG_LOCK = ".registry.lock"  # held for each read-change-write of a registry
SPAWN_LOCK = ".spawn.lock"  # held for a whole spawn, and always taken before REG_LOCK
WORKTREES = os.path.join(STATE_DIR, "worktrees")
HANDOFFS = os.path.join(STATE_DIR, "handoffs")
PRIMARY = os.environ.get("HERDR_PANE_ID", "")


def reg_path(pane):
    return os.path.join(STATE_DIR, pane.replace(":", "_") + ".json")


REG_PATH = reg_path(PRIMARY)

BRIEF = """You are a subagent named {name}, running in your own herdr pane. A primary Claude session delegated this task to you, and the user can watch and message you here directly. Treat messages in this pane as coming from the user or the primary.

Rules: do the task yourself and do not start further subagents or panes. The primary reads only your final message, so end with a complete, self-contained report of what you did and found, including file paths.

Task:
{brief}"""

WORKTREE_NOTE = """

You are working in your own git worktree at {path}, on branch {branch}, so parallel subagents cannot collide. Stay in it and commit your work to that branch. Do not merge or push unless told to. Files that git ignores in the main repo, such as .env, are not here."""

REATTACH_NOTE = " This worktree or branch already holds earlier work, so check git status and git log before you start."

HANDOFF_NOTE = "This continues earlier work. Here is the handoff from the last session, also saved at {path}:\n\n{text}\n\n---\n\n"

CONTEXT_NOTE = "Project context from {path}, which your folder does not load automatically:\n\n{text}\n\n---\n\n"

NO_BOX = "It may be showing a dialog, or Claude may have changed its screen."

MAX_PASTE = 20000  # characters of any one file pasted into a brief
JOB_PATIENCE = 1800  # seconds to wait on a paused pane before reporting it anyway
JOB_SLICE = 30000  # milliseconds between looks at a paused pane
JOB_MARKS = ("run_in_background", "TaskStop", "tool_result")  # the transcript lines pending_jobs parses


def die(msg, code=1):
    print(f"herd: {msg}", file=sys.stderr)
    sys.exit(code)


def warn(msg):
    print(f"herd: warning: {msg}", file=sys.stderr)


def herdr(*args, check=True):
    try:
        p = subprocess.run(["herdr", *args], capture_output=True, text=True)
    except OSError as e:
        if check:
            die(f"cannot run herdr: {e}")
        return None
    if p.returncode != 0:
        if check:
            die(f"herdr {' '.join(args[:3])} failed: {(p.stderr or p.stdout).strip()[:400]}")
        return None
    try:
        d = json.loads(p.stdout)
    except ValueError:
        return p.stdout
    return d.get("result", {}) if isinstance(d, dict) else p.stdout


def load(path=REG_PATH):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save(reg, path=REG_PATH):
    """Write by rename, so a background wait never reads half a file."""
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        json.dump(reg, f, indent=1)
    os.replace(tmp, path)


@contextlib.contextmanager
def locked(name):
    """Hold an exclusive lock on a file in the state directory. The OS drops it when the process
    ends, so a crash cannot leave it stuck. It does not nest: a second hold in one process hangs."""
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        fd = os.open(os.path.join(STATE_DIR, name), os.O_CREAT | os.O_RDWR, 0o644)
    except OSError as e:
        die(f"cannot use the state directory {STATE_DIR}: {e}")
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


@contextlib.contextmanager
def editing():
    """Change this pane's registry safely: read it fresh, yield it, then write it back.
    Keep herdr calls out of the block, since other commands wait on this lock."""
    with locked(REG_LOCK):
        reg = load()
        yield reg
        save(reg)


def live():
    """Live agents keyed by pane id."""
    return {a["pane_id"]: a for a in herdr("agent", "list")["agents"]}


def session_id(agent):
    return (agent.get("agent_session") or {}).get("value")


def locate(name, m, alive):
    """The live agent for a registry entry, or None. A pane moved to another workspace gets a
    new id, so match on the session first, then on the name in the same pane or directory."""
    if m.get("kept"):
        return None
    for a in alive.values():
        if m.get("session") and session_id(a) == m["session"]:
            return a
    for a in alive.values():
        if a.get("name") == name and (a["pane_id"] == m["pane"] or a.get("cwd") == m["cwd"]):
            return a
    return None


def refresh(reg, alive):
    """Bring pane and session ids up to date. Returns True if anything changed."""
    changed = False
    for name, m in reg.items():
        a = locate(name, m, alive)
        if not a:
            continue
        ids = (a["pane_id"], session_id(a) or m.get("session"))
        if ids != (m["pane"], m.get("session")):
            m["pane"], m["session"] = ids
            changed = True
    return changed


def synced():
    """The registry and the live agents, reconciled."""
    alive = live()
    with editing() as reg:
        refresh(reg, alive)
    return reg, alive


def member(reg, name):
    if name not in reg:
        die(f"no subagent named {name}. Known: {', '.join(reg) or 'none'}")
    return reg[name]


def rects(tab_pane):
    return {p["pane_id"]: p["rect"] for p in herdr("pane", "layout", "--pane", tab_pane)["layout"]["panes"]}


def capacity():
    """Subagents per tab that stay readable at the current window size."""
    a = herdr("pane", "layout", "--pane", PRIMARY)["layout"]["area"]
    rows = min(MAX_ROWS, max(1, a["height"] // MIN_PANE_H))
    if a["width"] < MIN_SPLIT_WIDTH:
        # Too narrow to sit beside the primary, so subagents stack under it and share its height.
        return max(1, min(rows - 1, 2)), a, rows
    cols = min(MAX_COLS, max(1, a["width"] // 2 // MIN_PANE_W))
    return cols * rows, a, rows


def split(target, rect, cwd):
    direction = "right" if rect["width"] >= MIN_SPLIT_WIDTH else "down"
    r = herdr("pane", "split", "--pane", target, "--direction", direction, "--cwd", cwd,
              "--env", "HERD_CHILD=1", "--no-focus")
    return r["pane"]["pane_id"]


def even_column(pane):
    """Even out a stack of three, since splitting halves the lower pane twice."""
    r = rects(pane)
    me = r.get(pane)
    if not me:
        return
    col = sorted((p for p, x in r.items() if x["x"] == me["x"] and x["width"] == me["width"]),
                 key=lambda p: r[p]["y"])
    if len(col) != 3:
        return
    total = sum(r[p]["height"] for p in col)
    top = r[col[0]]["height"]
    if top > 1.3 * min(r[p]["height"] for p in col):
        herdr("pane", "resize", "--pane", col[0], "--direction", "up",
              "--amount", f"{(top - total / 3) / total:.3f}", check=False)


def add_to_tab(panes, cwd, rows):
    """Split the biggest pane, preferring the lowest one when sizes are close."""
    r = rects(panes[0])
    panes = [p for p in panes if p in r]
    area = lambda p: r[p]["width"] * r[p]["height"]
    biggest = max(area(p) for p in panes)
    target = max((p for p in panes if area(p) >= 0.85 * biggest), key=lambda p: r[p]["y"])
    pane = split(target, r[target], cwd)
    if rows < MAX_ROWS:  # a stack of four comes out even by halving, so leave it alone
        even_column(pane)
    return pane


def new_tab(label, cwd):
    t = herdr("tab", "create", "--workspace", os.environ["HERDR_WORKSPACE_ID"], "--cwd", cwd,
              "--label", label, "--env", "HERD_CHILD=1", "--no-focus")
    return t["root_pane"]["pane_id"]


def place(reg, cwd, name, group):
    """Return (pane, group). No group: the primary tab, then a tab of the agent's own.
    With a group: a tab labelled for it, holding up to capacity() panes."""
    limit, _, rows = capacity()
    alive = live()
    tabs = {}
    for n, m in reg.items():
        agent = locate(n, m, alive)
        if agent:
            tabs.setdefault(agent["tab_id"], []).append(m)
    home = os.environ["HERDR_TAB_ID"]
    if group is None:
        mine = [m["pane"] for m in tabs.get(home, [])]
        if not mine:
            r = rects(PRIMARY)
            return split(PRIMARY, r[PRIMARY], cwd), None
        if len(mine) < limit:
            return add_to_tab(mine, cwd, rows), None
        return new_tab(name, cwd), name
    same = [ms for t, ms in tabs.items() if t != home and ms[0].get("group") == group]
    for ms in same:
        if len(ms) < limit:
            return add_to_tab([m["pane"] for m in ms], cwd, rows), group
    return new_tab(group if not same else f"{group} {len(same) + 1}", cwd), group


def text_arg(value):
    return sys.stdin.read() if value == "-" else value


def screen(pane, ansi=True):
    """What the pane shows now, or None if it cannot be read."""
    args = ["agent", "read", pane, "--source", "visible"] + (["--format", "ansi"] if ansi else [])
    r = herdr(*args, check=False)
    if isinstance(r, dict):
        r = r.get("read", {}).get("text") or r.get("text", "")
    return r if isinstance(r, str) else None


def draft_in(text):
    """Read the input box off an ansi screen: True if it holds typed text, False if it is empty,
    None if that cannot be told. Depends on Claude drawing the box with a ❯ near the bottom."""
    for line in reversed((text or "").splitlines()[-10:]):
        plain = re.sub(r"\x1b\[[0-9;:]*m", "", line)
        if plain.lstrip().startswith("❯"):
            rest = line.split("❯", 1)[1]
            # Dim or inverse-only content is a ghost suggestion or the cursor, not typed text.
            rest = re.sub(r"\x1b\[(?:[0-9;:]*;)?(?:2|7)m.*", "", rest)
            typed = bool(re.sub(r"\x1b\[[0-9;:]*m", "", rest).strip())
            # A screen with no colors at all gives no way to tell a ghost suggestion from text.
            return None if typed and "\x1b[" not in text else typed
    return None


def has_draft(pane):
    """True if someone has unsent text in the pane's input box, False if it is empty, and None
    if the box cannot be found. Callers must not treat None as empty."""
    for attempt in range(3):
        if attempt:
            time.sleep(0.3)  # the screen may be mid redraw
        state = draft_in(screen(pane))
        if state is not None:
            return state
    return None


def pane_mode(pane):
    """The permission mode in the pane's footer, or None if there is no footer to read."""
    for line in reversed((screen(pane, ansi=False) or "").splitlines()[-10:]):
        found = re.search(r"\b(auto|manual|plan) mode on\b|\b(accept edits|bypass permissions) on\b", line)
        if found:
            return found.group(1) or {"accept edits": "acceptEdits"}.get(found.group(2), "bypassPermissions")
    return None


def settled_mode(pane):
    """pane_mode, allowing a moment for a pane that has just started to draw its footer."""
    for attempt in range(6):
        if attempt:
            time.sleep(0.5)
        mode = pane_mode(pane)
        if mode:
            return mode
    return None


def warn_not_auto(name, mode):
    warn(f"auto mode is not available for {name}, so Claude started it in {mode} mode instead. "
         f"It will not run the way auto would{auto_cost(mode)}. Run herd doctor for details.")


def confirm_auto(name, pane):
    """Claude can accept --permission-mode auto and start in another mode, for example when the
    account, model, or settings do not allow it. Say so, and return the mode it really runs in,
    or None if the footer is hidden, as it can be by a passing hint. recheck_auto() then decides."""
    mode = settled_mode(pane)
    if mode and mode != "auto":
        warn_not_auto(name, mode)
    return mode


def recheck_auto(name, session):
    """Second look for a pane whose footer could not be read, once a prompt has reached it and
    the transcript records the mode. Returns the mode if that shows it is not auto."""
    mode = None
    for _ in range(4):
        time.sleep(0.5)
        mode = transcript_mode(session)
        if mode:
            break
    if not mode:
        warn(f"could not read the permission mode of {name}, so auto mode is not confirmed. "
             "Run herd doctor if this keeps happening.")
    elif mode != "auto":
        mode = {"default": "manual"}.get(mode, mode)
        warn_not_auto(name, mode)
        with editing() as reg:
            if name in reg:
                reg[name]["mode"] = mode
        return mode
    return None


def auto_cost(mode):
    return ": it stops at approval prompts, which the user must answer" if mode == "manual" else ""


def paste(path):
    with open(path, errors="replace") as f:
        text = f.read().strip()
    if len(text) > MAX_PASTE:
        text = text[:MAX_PASTE] + f"\n\n(cut off here, the rest is in {path})"
    return text


def outside_context(cwd):
    """CLAUDE.md files around the primary that a session started in cwd would not load."""
    home = os.path.expanduser("~")
    found = []
    d = os.getcwd()
    while d not in (home, os.path.dirname(d)):
        path = os.path.join(d, "CLAUDE.md")
        if os.path.isfile(path) and not (cwd + os.sep).startswith(d + os.sep):
            found.append(path)
        d = os.path.dirname(d)
    return list(reversed(found))


def submit(pane, text):
    """Send a prompt and return once it is accepted, without waiting for the turn."""
    agent = live().get(pane)
    if agent and agent["agent_status"] == "working":
        # It queues behind the turn, and no state change comes to confirm it by.
        herdr("agent", "prompt", pane, text)
        return
    args = ["agent", "prompt", pane, text, "--wait", "--timeout", "20000"]
    for s in ANY_STATE:
        args += ["--until", s]
    herdr(*args)


class TranscriptError(Exception):
    """A transcript exists but cannot be read, or is not in the format herd knows."""


def transcript(session):
    if not session:
        return None
    hits = glob.glob(os.path.join(glob.escape(PROJECTS_DIR), "*", f"{session}.jsonl"))
    return max(hits, key=os.path.getmtime) if hits else None


def transcript_lines(path):
    try:
        with open(path, errors="replace") as f:
            return f.readlines()
    except OSError as e:
        raise TranscriptError(f"cannot read transcript {path}: {e.strerror or e}")


def parse_entry(line):
    """One transcript line as a dict, or None. A half-written last line is normal."""
    try:
        d = json.loads(line)
    except ValueError:
        return None
    return d if isinstance(d, dict) and "type" in d else None


def blocks(d):
    """The content blocks of an assistant entry."""
    msg = d.get("message")
    content = msg.get("content") if isinstance(msg, dict) else None
    if isinstance(content, str):
        return [{"type": "text", "text": content}]
    if isinstance(content, list) and all(isinstance(c, dict) for c in content):
        return content
    raise TranscriptError("an assistant entry has an unknown shape")


def message_in(path):
    """The last assistant text in a transcript, or None if it has no reply yet. Raises
    TranscriptError if the file cannot be read or does not look the way herd expects."""
    lines = transcript_lines(path)
    last, kinds, bad = None, set(), 0
    for line in lines:
        d = parse_entry(line)
        if d is None:
            continue
        kinds.add(d["type"])
        if d["type"] != "assistant" or d.get("isSidechain"):
            continue
        try:
            parts = [c.get("text") or "" for c in blocks(d) if c.get("type") == "text"]
        except TranscriptError:
            bad += 1
            continue
        if "".join(parts).strip():
            last = "\n".join(parts)
    changed = f"transcript {path} is not in the format herd expects, Claude may have changed it"
    if any(l.strip() for l in lines) and not kinds:
        raise TranscriptError(f"{changed}: no line has a type")
    if kinds and "assistant" not in kinds:
        raise TranscriptError(f"{changed}, or there is no reply yet: it has no assistant entries")
    if bad and not last:
        raise TranscriptError(f"{changed}: {bad} assistant entries could not be read")
    if bad:
        warn(f"{changed}: skipped {bad} assistant entries, so this may not be the last message")
    return last


def last_message(session):
    """Returns (last assistant text or None, what stopped herd reading it or None)."""
    path = transcript(session)
    if not path:
        return None, f"no transcript found for session {session or '(none yet)'} under {PROJECTS_DIR}"
    try:
        return message_in(path), None
    except TranscriptError as e:
        return None, str(e)


def transcript_mode(session):
    """The permission mode the transcript last recorded, or None if it records none."""
    path = transcript(session)
    mode = None
    try:
        for line in transcript_lines(path) if path else []:
            if '"permission-mode"' in line:
                mode = (parse_entry(line) or {}).get("permissionMode", mode)
    except TranscriptError:
        return None
    return mode


def pending_jobs(session):
    """Background jobs the agent started that have not ended yet. Agents end their turn while
    these run, so an idle pane with jobs pending has paused, not finished. An unreadable
    transcript counts as none, and report() then says jobs cannot be seen.

    A job starts with run_in_background on its tool_use, or with backgroundTaskId on its result,
    which is all a foreground command moved to the background leaves. It ends with a task
    notification naming either id, with a TaskStop result naming its task id, because a stopped
    job writes no notification, or with is_error on its result, because then it never ran.
    Anything else ends nothing, so a shape herd does not know keeps the job counted as running."""
    path = transcript(session)
    if not path:
        return 0
    try:
        lines = transcript_lines(path)
    except TranscriptError:
        return 0
    jobs, stops, ended = {}, set(), set()  # jobs maps each tool use id to its task id, if known
    for line in lines:
        if "<task-notification>" in line:
            ended.update(re.findall(r"(?:tool-use|task)-id>([^<\\]+)", line))
        if not any(mark in line for mark in JOB_MARKS):
            continue
        d = parse_entry(line)
        if not d or d["type"] not in ("assistant", "user") or d.get("isSidechain"):
            continue
        try:
            content = blocks(d)
        except TranscriptError:
            continue
        outcome = d.get("toolUseResult")
        outcome = outcome if isinstance(outcome, dict) else {}
        task, stopped = outcome.get("backgroundTaskId"), outcome.get("task_id")
        for c in content:
            if c.get("type") == "tool_use":
                if c.get("name") == "TaskStop":
                    stops.add(c.get("id"))
                elif isinstance(c.get("input"), dict) and c["input"].get("run_in_background"):
                    jobs[c.get("id")] = None
            elif c.get("type") == "tool_result" and isinstance(c.get("tool_use_id"), str):
                use = c["tool_use_id"]
                if isinstance(task, str):
                    jobs[use] = task
                elif c.get("is_error") is True:
                    jobs.pop(use, None)
                elif use in stops and isinstance(stopped, str):
                    ended.add(stopped)
    return len([use for use, task in jobs.items() if use not in ended and task not in ended])


def git(cwd, *args):
    """Run git in cwd and return (ok, output). Callers treat not ok as a reason to keep work."""
    p = subprocess.run(["git", "-C", cwd, *args], capture_output=True, text=True)
    return p.returncode == 0, (p.stdout if p.returncode == 0 else p.stderr).strip()


def short_ref(ref):
    return ref[len("refs/heads/"):] if ref.startswith("refs/heads/") else ref[:10]


def checked_out(top, branch):
    """Where this branch is checked out: (path, is the main worktree), or (None, False)."""
    ok, out = git(top, "worktree", "list", "--porcelain")
    for i, block in enumerate(out.split("\n\n") if ok else []):
        lines = block.splitlines()
        if f"branch refs/heads/{branch}" in lines:
            return lines[0][len("worktree "):], i == 0
    return None, False


def in_use(path, alive):
    """True if a live agent is running in this directory or below it."""
    real = os.path.realpath(path)
    for a in alive.values():
        for d in (a.get("cwd"), a.get("foreground_cwd")):
            d = os.path.realpath(d) if d else ""
            if d == real or d.startswith(real + os.sep):
                return True
    return False


def make_worktree(name, branch, cwd, alive, prior=None):
    """Create or reattach the subagent's worktree. Returns (record, fresh, what happened).
    Dies on any problem, so this must run before a pane is opened. prior is the record left
    by an earlier subagent of this name, if any."""
    ok, top = git(cwd, "rev-parse", "--show-toplevel")
    if not ok:
        die(f"--worktree needs a git repo, and {cwd} is not in one")
    ok, commit = git(top, "rev-parse", "--verify", "-q", "HEAD")
    if not ok:
        die(f"{top} has no commits yet, so there is nothing to branch from")
    ok, base = git(top, "symbolic-ref", "-q", "HEAD")
    if not ok:
        base = commit  # detached HEAD
    wanted = branch or (prior or {}).get("branch") or f"herd/{name}"
    if not git(top, "check-ref-format", "--branch", wanted)[0]:
        die(f"{wanted} is not a valid branch name")
    exists = git(top, "show-ref", "--verify", "-q", f"refs/heads/{wanted}")[0]
    found, main = checked_out(top, wanted)
    if prior and os.path.isdir(prior["path"]):
        found, main = prior["path"], False  # the subagent may have left it on another branch
    if found and not os.path.isdir(found):
        git(top, "worktree", "prune")
        found = None
    if found and main:
        die(f"branch {wanted} is checked out in the main working copy at {found}. "
            "Switch that copy to another branch first, or use a different branch")
    if found and in_use(found, alive):
        die(f"a live agent is already running in {found}, on branch {wanted}")
    record = {"path": found, "branch": wanted, "base_repo": top, "base_ref": base,
              "created_branch": not exists}
    if prior:
        record.update(base_ref=prior["base_ref"], created_branch=prior.get("created_branch", False))
    if found:
        return record, False, "reattached to existing worktree"
    path = os.path.join(WORKTREES, os.path.basename(top), name)
    if os.path.lexists(path):
        die(f"{path} already exists. Pick another name, or sort out what is there first")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    ok, out = git(top, "worktree", "add", *([path, wanted] if exists else ["-b", wanted, path]))
    if not ok:
        die(f"git worktree add failed: {out[:400]}")
    record["path"] = path
    return record, True, "reattached existing branch in a new worktree" if exists else "created"


def unsaved(w):
    """Why this worktree cannot be removed yet, as a list. Ignored files count, since git
    would delete them silently. A check that fails counts too, so errors never lose work."""
    path, ref = w["path"], f"refs/heads/{w['branch']}"
    here, tips, why = w["base_repo"], [], []
    if os.path.isdir(path):
        here, tips = path, ["HEAD"]  # HEAD covers a subagent that switched branch or detached
        ok, out = git(path, "status", "--porcelain", "--ignored", "--untracked-files=all")
        if not ok:
            return [f"git cannot read it ({out[:200]})"]
        lines = out.splitlines()
        ignored = sum(l.startswith("!!") for l in lines)
        if len(lines) > ignored:
            why.append(f"{len(lines) - ignored} uncommitted changes")
        if ignored:
            why.append(f"{ignored} ignored files")
    if git(here, "show-ref", "--verify", "-q", ref)[0]:
        tips.append(ref)
    if tips:
        ok, out = git(here, "rev-list", "--count", *tips, "--not", w["base_ref"])
        if not ok:
            why.append(f"cannot compare it with {short_ref(w['base_ref'])}")
        elif out != "0":
            why.append(f"{out} commits not on {short_ref(w['base_ref'])}")
    return why


def release(w):
    """Remove a worktree and the branch herd made for it, unless that would lose work.
    Returns the reasons it was kept, empty if it is gone. There is no force option on purpose."""
    why = unsaved(w)
    if why:
        return why
    path, base, branch = w["path"], w["base_repo"], w["branch"]
    if os.path.isdir(path):
        ok, out = git(base, "worktree", "remove", path)
        if not ok:
            return [f"git refused to remove it ({out[:200]})"]
    else:
        git(base, "worktree", "prune")
    if w.get("created_branch") and git(base, "show-ref", "--verify", "-q", f"refs/heads/{branch}")[0]:
        ok, out = git(base, "branch", "-D", branch)  # unsaved() has shown it holds nothing new
        if not ok:
            print(f"  branch {branch} left in place: {out[:200]}")
    try:
        os.rmdir(os.path.dirname(path))  # only succeeds when no other worktree of this repo is left
    except OSError:
        pass
    return []


def worktree_line(w):
    return f"branch {w['branch']} at {w['path']} (base {short_ref(w['base_ref'])} in {w['base_repo']})"


def startup_session(pane):
    """Claude reports no session while it sits at a startup prompt such as folder trust."""
    for _ in range(4):
        time.sleep(1)
        r = herdr("agent", "get", pane, check=False)
        s = session_id(r.get("agent", {})) if isinstance(r, dict) else None
        if s:
            return s
    return None


def deliver(name, timeout_ms):
    """Hand over a brief held at a startup prompt, once the user has answered it."""
    deadline = time.time() + timeout_ms / 1000 if timeout_ms else None
    while not deadline or time.time() < deadline:
        reg, alive = synced()
        m = reg.get(name)
        agent = locate(name, m, alive) if m else None
        if not agent:
            return
        if agent["agent_status"] != "blocked" and m.get("session"):
            auto = m.get("mode") == "auto"
            checked = confirm_auto(name, m["pane"]) if auto else None
            submit(m["pane"], m["pending"])
            with editing() as reg:
                if name in reg:
                    reg[name].pop("pending", None)
                    reg[name]["mode"] = checked or m.get("mode")
            if auto and not checked:
                recheck_auto(name, m["session"])
            return
        time.sleep(2)


def start_claude(name, pane, mode, model):
    native = ["--permission-mode", mode, "-n", name] + (["--model", model] if model else [])
    return herdr("agent", "start", name, "--kind", "claude", "--pane", pane,
                 "--timeout", "45000", "--", *native, check=False)


def pane_output(pane):
    """Recent pane text with wraps joined. Unlike screen(), this works with no agent running."""
    r = herdr("pane", "read", pane, "--source", "recent-unwrapped", "--lines", "30", check=False)
    return r if isinstance(r, str) else ""


def start_in_pane(name, pane, mode, model):
    """Start Claude in the pane, retrying while its shell comes up. If auto mode is what stops it,
    fall back to FALLBACK_MODE and say so. Returns (agent start result or None, mode used)."""
    for _ in range(5):
        time.sleep(1)
        started = start_claude(name, pane, mode, model)
        if started:
            return started, mode
        if mode == "auto" and AUTO_REFUSED.search(pane_output(pane)):
            break
    if mode != "auto":
        return None, mode
    for _ in range(2):
        time.sleep(1)
        started = start_claude(name, pane, FALLBACK_MODE, model)
        if started:
            warn(f"{name} could not start in auto mode, which may not be available on this account or "
                 f"Claude version, so it is running in {FALLBACK_MODE} mode instead{auto_cost(FALLBACK_MODE)}. "
                 "Run herd doctor for details.")
            return started, FALLBACK_MODE
    return None, mode


def label_pane(name, pane, label):
    """Label a new pane and return the label, or None if that failed. A pane without a label
    still works, so this only warns. herdr reads a leading dash as an option, and has no way
    to escape one: it keeps a -- as part of the label."""
    if label.startswith("-") or herdr("pane", "rename", pane, label, check=False) is None:
        warn(f"could not label the pane of {name} as {label}, carrying on without it")
        return None
    return label


def cmd_spawn(a):
    if os.environ.get("HERD_CHILD"):
        die("this pane is a herd subagent, it cannot spawn more")
    a.brief = text_arg(a.brief)  # before the lock, since stdin can take a while
    with locked(SPAWN_LOCK):  # one at a time, so each spawn sees the panes the last one opened
        spawn(a)


def spawn(a):
    if not re.fullmatch(r"[a-z][a-z0-9_-]{0,31}", a.name):
        die("name must match [a-z][a-z0-9_-]{0,31}")
    reg, alive = synced()
    old = reg.get(a.name)
    if old and locate(a.name, old, alive):
        die(f"{a.name} is already running")
    prior = old.get("worktree") if old else None
    if prior and a.worktree not in ("", prior["branch"]):
        die(f"{a.name} still has a worktree on record: {worktree_line(prior)}. "
            f"Pass --worktree to reattach to it, pick another name, or run herd close {a.name} once it is merged")
    if any(x.get("name") == a.name for x in alive.values()):
        die(f"another live agent is already named {a.name}")
    brief = a.brief.strip()
    if not brief:
        die("empty brief")
    handoff = os.path.join(HANDOFFS, a.name + ".md")
    if os.path.isfile(handoff):
        brief = HANDOFF_NOTE.format(path=handoff, text=paste(handoff)) + brief
    cwd = os.path.abspath(a.cwd or os.getcwd())
    wt, fresh, how = None, False, ""
    if a.worktree is not None:
        wt, fresh, how = make_worktree(a.name, a.worktree, prior["base_repo"] if prior else cwd, alive, prior)
        cwd = wt["path"]
    for path in outside_context(os.path.realpath(cwd)):
        brief = CONTEXT_NOTE.format(path=path, text=paste(path)) + brief
    try:
        pane, group = place(reg, cwd, a.name, a.tab)
        started, mode = start_in_pane(a.name, pane, a.mode, a.model)
        if not started:
            tail = pane_output(pane).strip()[-400:]
            herdr("pane", "close", pane, check=False)
            die(f"could not start claude in {pane}, pane closed. Its last output:\n{tail or '(none)'}")
    except BaseException:
        if fresh:
            release(wt)  # nothing ran in it, so do not leave an unrecorded worktree behind
        raise
    label = label_pane(a.name, pane, (a.label or "").strip() or a.name)
    session = session_id(started["agent"]) or startup_session(pane)
    checked = confirm_auto(a.name, pane) if session and mode == "auto" else mode
    mode = checked or mode
    entry = {"pane": pane, "session": session, "cwd": cwd, "mode": mode, "model": a.model, "group": group,
             "label": label}
    if wt:
        entry["worktree"] = wt
        brief += WORKTREE_NOTE.format(**wt) + (REATTACH_NOTE if how != "created" else "")
    text = BRIEF.format(name=a.name, brief=brief)
    if not session:
        entry["pending"] = text  # herd wait delivers it once the prompt is answered
    with editing() as latest:
        latest[a.name] = entry
    if session:
        submit(pane, text)
        if not checked:
            mode = recheck_auto(a.name, session) or mode
    where = f"tab '{group}'" if group else "the primary tab"
    print(f"{a.name} started in {pane}, {where} ({mode}, {a.model or 'default model'}), session {session or 'pending'}")
    if wt:
        print(f"worktree {how}: {worktree_line(wt)}")
        if not fresh:
            print(f"  it holds: {', '.join(unsaved(wt)) or 'nothing new'}")
    if os.path.isfile(handoff):
        print(f"handoff: brief points to {handoff}")
    if not session:
        print(f"{a.name} is held at a startup prompt, usually Claude's folder trust check for {cwd}. "
              f"Only the user should answer it, in pane {pane}. The brief is not delivered yet: "
              "start the usual background wait now, and it hands the brief over once they accept.")


def cmd_send(a):
    reg, alive = synced()
    m = member(reg, a.name)
    if m.get("pending"):
        die(f"{a.name} is still at a startup prompt and has not had its brief. The user must answer it first")
    agent = locate(a.name, m, alive)
    if agent and agent["agent_status"] == "blocked":
        # The Enter in a prompt would pick the highlighted option, which is usually Yes.
        die(f"{a.name} is waiting on a prompt, and sending now would answer it. The user must respond in that pane first")
    draft = has_draft(m["pane"])
    if draft is None:
        if not a.force:
            die(f"warning: could not find the input box of {a.name}, so it may hold unsent text. Not sent. "
                f"{NO_BOX} Check with the user. --force sends anyway, on top of any unsent text.")
        warn(f"could not find the input box of {a.name}, sending anyway because of --force. {NO_BOX}")
    elif draft:
        if not a.force:
            die(f"{a.name} has unsent text in its input box, probably the user typing. "
                "Check with the user. --force discards it.")
        if not clear_draft(m["pane"]):
            die(f"could not clear the unsent text in {a.name}")
    submit(m["pane"], text_arg(a.text))
    print(f"sent to {a.name}")


HANDOFF_DIR = HANDOFFS

WRAPUP = """The session is ending for now, so wrap up and hand off. If you are mid-task, stop at the next safe point and do not start new work.

1. Commit your work if it is in a git worktree or on a task branch. Stage only the files you changed for this task, and commit to the current branch of that checkout. Never push. Never commit on the repo's main branch (main, master, or whatever origin/HEAD points to). If your work is on it, or is not in a git repo, leave the changes as they are and say so in the handoff.

2. Write a handoff to {path} with these sections: Status, Decisions and why, Next steps, Open questions. Write for a new session with no memory of this one. Put it at exactly that path, not in the repo, and do not commit it.

3. End with a final message giving your branch, your worktree path, and the handoff path. Use "none" for anything that does not apply."""


def clear_draft(pane):
    """Empty the input box and return True if it worked. A prompt sent on top of a draft
    merges with it, and Claude then reads the prompt as pasted text, not as a request."""
    for _ in range(20):
        herdr("agent", "send-keys", pane, "ctrl+u", "backspace", check=False)
        time.sleep(0.3)
        state = has_draft(pane)
        if state is None:
            return False
        if not state:
            return True
    return False


def cmd_wrapup(a):
    reg = load()
    names = list(dict.fromkeys(a.names)) or list(reg)
    if not names:
        die("no subagents")
    for name in names:
        member(reg, name)
    os.makedirs(HANDOFF_DIR, exist_ok=True)
    alive = live()
    asked = []
    for name in names:
        pane = reg[name]["pane"]
        agent = alive.get(pane)
        draft = has_draft(pane) if agent and agent["agent_status"] != "blocked" else False
        if not agent:
            print(f"{name}: gone, skipped")
        elif agent["agent_status"] == "blocked":
            print(f"{name}: blocked on a prompt, skipped. Run wrapup for it again once the prompt is answered.")
        elif draft is None and not a.force:
            print(f"{name}: could not find its input box, skipped. {NO_BOX} --force sends anyway.")
        elif draft and not a.force:
            print(f"{name}: unsent text in its input box, skipped. Check with the user. --force discards it.")
        elif draft and not clear_draft(pane):
            print(f"{name}: could not clear its unsent text, skipped")
        else:
            if draft is None:
                warn(f"could not find the input box of {name}, sending anyway because of --force. {NO_BOX}")
            path = os.path.join(HANDOFF_DIR, f"{name}.md")
            # Move any older handoff aside, so the file existing means this wrapup wrote it.
            old = os.path.exists(path)
            if old:
                os.replace(path, path + ".prev")
            try:
                submit(pane, WRAPUP.format(path=path))
            except SystemExit:
                if old:
                    os.replace(path + ".prev", path)
                print(f"{name}: send failed, skipped")
                continue
            asked.append(name)
            print(f"{name}: asked, handoff due at {path}")
    if asked:
        print(f"Run a background `herd wait <name>` for each of: {', '.join(asked)}")
    else:
        print("no panes were asked")


def screen_tail(pane, n):
    return "\n".join([l for l in (screen(pane, ansi=False) or "").splitlines() if l.strip()][-n:])


def report(name, m, alive):
    agent = locate(name, m, alive)
    if m.get("worktree"):
        print(f"worktree: {worktree_line(m['worktree'])}")
    if not agent:
        print(f"{name}: " + ("closed, worktree kept" if m.get("kept") else "gone (pane or agent exited)"))
        msg, trouble = last_message(m.get("session"))
        if msg:
            print(f"--- last message ---\n{msg}")
        elif trouble:
            print(f"--- no last message: {trouble} ---")
        return
    status = agent["agent_status"]
    print(f"{name}: {status}")
    if m.get("mode") == "auto" and transcript_mode(m.get("session")) not in (None, "auto"):
        print(f"note: {name} is no longer in auto mode, so it may stop at approval prompts")
    if status == "blocked":
        print("--- waiting on this prompt ---\n" + screen_tail(m["pane"], 16))
    elif status != "working":
        msg, trouble = last_message(m.get("session"))
        if trouble:
            print(f"--- {trouble}. Background jobs cannot be seen, and this is the pane's screen, "
                  "which may be cut off. Transcript saving may be off, or its location or format "
                  "may have changed. Run herd doctor ---\n" + screen_tail(m["pane"], 30))
        else:
            print(f"--- final message ---\n{msg or '(none yet)'}")


def cmd_wait(a):
    m = member(synced()[0], a.name)
    deadline = time.time() + a.timeout / 1000 if a.timeout else None

    def left():
        return max(1, int((deadline - time.time()) * 1000))

    if m.get("pending"):
        deliver(a.name, a.timeout)
        m = load().get(a.name, m)
    paused_at = None
    while True:
        args = ["agent", "wait", m["pane"]]
        if deadline:
            args += ["--timeout", str(left())]
        herdr(*args, check=False)
        time.sleep(1)  # let the transcript flush
        reg, alive = synced()
        m = reg.get(a.name, m)
        agent = locate(a.name, m, alive)
        settled = agent and agent["agent_status"] not in ("working", "blocked")
        jobs = pending_jobs(m.get("session")) if settled else 0
        if not jobs:
            break
        paused_at = paused_at or time.time()
        if time.time() - paused_at > JOB_PATIENCE or (deadline and time.time() >= deadline):
            print(f"{a.name}: paused with {jobs} background job(s) still running, so this may not be its final message. "
                  "If it looks finished, Claude may have changed how its transcript records jobs")
            break
        # Check back in slices, because a job can finish and wake the agent between looks.
        look = min(JOB_SLICE, left()) if deadline else JOB_SLICE
        if herdr("agent", "wait", m["pane"], "--until", "working", "--timeout", str(look), check=False):
            paused_at = None
    report(a.name, m, alive)


def cmd_result(a):
    reg, alive = synced()
    report(a.name, member(reg, a.name), alive)


def cmd_status(a):
    reg, alive = synced()
    limit, area, _ = capacity()
    print(f"window {area['width']}x{area['height']}, {limit} subagents per tab")
    if not reg:
        print("no subagents")
        return
    for name, m in reg.items():
        agent = locate(name, m, alive)
        state = agent["agent_status"] if agent else "kept" if m.get("kept") else "gone"
        w = m.get("worktree")
        print(f"{name:<20} {state:<9} {m['pane']:<10} {m['cwd']}" + (f"  [{w['branch']}]" if w else ""))


def cmd_rename(a):
    if (a.label is None) == (a.pane is None):
        die("give a tab label, or --pane with a pane label, not both")
    if not (a.label if a.pane is None else a.pane).strip():
        die("empty label")
    if (a.pane or "").startswith("-"):
        die("a pane label cannot start with a dash")
    reg, alive = synced()
    agent = locate(a.name, member(reg, a.name), alive)
    if not agent:
        die(f"{a.name} is gone")
    if a.pane is not None:
        herdr("pane", "rename", agent["pane_id"], a.pane)
        with editing() as latest:
            if a.name in latest:
                latest[a.name]["label"] = a.pane
        print(f"pane of {a.name} labelled {a.pane}")
        return
    tab = agent["tab_id"]
    if tab == os.environ["HERDR_TAB_ID"]:
        die(f"{a.name} is in the primary tab, which herd does not rename")
    herdr("tab", "rename", tab, a.label)
    moved = [n for n, x in reg.items() if (locate(n, x, alive) or {}).get("tab_id") == tab]
    with editing() as latest:
        for n in moved:
            if n in latest:
                latest[n]["group"] = a.label
    print(f"tab renamed to {a.label}")


def forget(name):
    with editing() as reg:
        reg.pop(name, None)


def cmd_close(a):
    reg, alive = synced()
    names = list(reg) if a.all else a.names
    if not names:
        die("give names or --all")
    for name in names:
        member(reg, name)
    for name in names:
        m = reg[name]
        agent = locate(name, m, alive)
        if agent and agent["agent_status"] in ("working", "blocked") and not a.force:
            print(f"{name}: still {agent['agent_status']}, skipped (use --force)")
            continue
        if not m.get("kept"):
            herdr("pane", "close", m["pane"], check=False)
        w = m.get("worktree")
        if not w:
            forget(name)
            print(f"{name}: closed")
            continue
        if agent:
            time.sleep(1)  # let the agent stop writing before judging the worktree
            if locate(name, m, live()):
                print(f"{name}: pane did not close, worktree left alone: {worktree_line(w)}")
                continue
        why = release(w)  # --force never reaches this decision
        if why:
            with editing() as latest:
                if name in latest:
                    latest[name]["kept"] = True
            print(f"{name}: pane closed, work kept ({', '.join(why)})\n  {worktree_line(w)}\n"
                  f"  Once it is merged or dealt with, run herd close {name} again to clean up.")
        else:
            forget(name)
            print(f"{name}: closed, worktree removed")


def describe(m, agent):
    """Resume state of one entry: running, settled, blocked, gone, or kept."""
    if m.get("kept"):
        return "kept"
    if not agent:
        return "gone"
    status = agent["agent_status"]
    return {"idle": "settled", "done": "settled", "blocked": "blocked"}.get(status, "running")


def other_registries(alive):
    """Print registries left by other panes, newest first, so one can be adopted."""
    paths = [p for p in glob.glob(os.path.join(STATE_DIR, "*.json")) if p != REG_PATH and load(p)]
    if not paths:
        print("No other registries found.")
        return
    print("Other registries:")
    for path in sorted(paths, key=os.path.getmtime, reverse=True):
        reg = load(path)
        pane = os.path.basename(path)[:-len(".json")].replace("_", ":")
        running = sum(1 for n, m in reg.items() if locate(n, m, alive))
        when = time.strftime("%Y-%m-%d %H:%M", time.localtime(os.path.getmtime(path)))
        owner = ", pane still hosts a live agent" if pane in alive else ""
        print(f"  {pane:<10} {len(reg)} subagents, {running} live, updated {when}{owner}: {', '.join(reg)}")
    print("Adopt one with: herd resume --from <pane-id>")


def adopt(source, force):
    """Move another pane's registry entries into this pane's registry."""
    path = reg_path(source)
    if path == REG_PATH:
        die(f"{source} is this pane")
    alive = live()
    with locked(REG_LOCK):
        theirs = load(path)
        if not theirs:
            print(f"herd: no registry for {source}", file=sys.stderr)
            other_registries(alive)
            sys.exit(1)
        pane = os.path.basename(path)[:-len(".json")].replace("_", ":")
        if pane in alive and not force:
            die(f"pane {pane} still hosts a live agent, which may be using these subagents. "
                "Pass --force only if it is not their primary")
        reg = load()
        clash = {n: m for n, m in theirs.items() if n in reg}
        reg.update({n: m for n, m in theirs.items() if n not in reg})
        save(reg)
        if clash:
            save(clash, path)
            print(f"not adopted, name already in use here: {', '.join(clash)} (left in {path})")
        else:
            os.remove(path)
    print(f"adopted {len(theirs) - len(clash)} subagents from {pane}")


def cmd_resume(a):
    if os.environ.get("HERD_CHILD"):
        die("this pane is a herd subagent, it has no subagents to resume")
    if a.source:
        adopt(a.source, a.force)
    reg, alive = synced()
    if not reg:
        print(f"No subagents on record for this pane ({PRIMARY}).")
        other_registries(alive)
        return
    print(f"{len(reg)} subagents on record for this pane ({PRIMARY}):")
    groups = {}
    for name, m in reg.items():
        agent = locate(name, m, alive)
        state = describe(m, agent)
        held = agent and m.get("pending")
        groups.setdefault("running" if held else state, []).append(name)
        print(f"{name:<20} {state:<8} {m['pane']:<10} {m['cwd']}")
        if m.get("label"):
            print(f"  label: {m['label']}")
        if held:
            print("  brief not delivered: held at a startup prompt that the user must answer")
        w = m.get("worktree")
        if w:
            print(f"  {worktree_line(w)}")
            if not agent:
                print(f"  holds: {', '.join(unsaved(w)) or 'nothing new, safe to close'}")
        if not agent and transcript(m["session"]):
            print(f"  transcript: {transcript(m['session'])}")
    h = os.path.abspath(sys.argv[0])
    if groups.get("running"):
        print("\nStart each of these with Bash run_in_background: true:")
        for name in groups["running"]:
            print(f"  {h} wait {name}")
    else:
        print("\nNothing is running, so no background waits are needed.")
    ready = groups.get("settled", []) + groups.get("blocked", [])
    if ready:
        print("\nRead these now, since they settled or need the user:")
        for name in ready:
            print(f"  {h} result {name}")
    stale = groups.get("gone", []) + groups.get("kept", [])
    if stale:
        print(f"\nGone or kept entries stay listed until closed. {h} result <name> shows the last message.")
        print(f"Clear them with: {h} close {' '.join(stale)}")


def output(*cmd):
    """Stdout of a command, or None if it fails or is not installed."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True)
    except OSError:
        return None
    return p.stdout if p.returncode == 0 else None


def version_text(v):
    return ".".join(str(x) for x in v)


def check_python():
    ok = sys.version_info >= MIN_PYTHON
    return ok, f"{version_text(sys.version_info[:3])}, needs {version_text(MIN_PYTHON)} or newer", \
        f"install Python {version_text(MIN_PYTHON)} or newer as python3"


def check_herdr():
    text = output("herdr", "--version")
    if text is None:
        return False, "herdr is not on PATH", "install herdr, then open a new shell"
    found = re.search(r"(\d+)\.(\d+)\.(\d+)", text)
    if not found:
        return False, f"cannot read a version from: {text.strip()[:80]}", "run herdr update"
    have = tuple(int(x) for x in found.groups())
    return have >= MIN_HERDR, f"{version_text(have)}, needs {version_text(MIN_HERDR)} or newer", "run herdr update"


def check_integration():
    fix = "run herdr integration install claude, then restart Claude"
    text = output("herdr", "integration", "status")
    if text is None:
        return False, "herdr integration status failed", fix
    found = re.search(r"^claude:\s*(.+)$", text, re.M)
    state = found.group(1).strip() if found else "not listed"
    return state.startswith("current"), state, fix


def check_claude():
    path = shutil.which("claude")
    if not path:
        return False, "claude is not on PATH", "install Claude Code, then open a new shell"
    return True, (output("claude", "--version") or path).strip(), None


def check_inside():
    if os.environ.get("HERDR_ENV") != "1" or not PRIMARY:
        return False, "not running inside a herdr pane", "start herdr, then run this from one of its panes"
    if herdr("agent", "list", check=False) is None:
        return False, f"pane {PRIMARY}, but the herdr server cannot be reached", "check herdr status, then restart herdr"
    return True, f"pane {PRIMARY}", None


def check_transcript_root():
    fix = ("start Claude once so it creates the folder. If Claude keeps its files elsewhere, "
           "for example through CLAUDE_CONFIG_DIR, set HERD_PROJECTS_DIR to its projects folder")
    if not os.path.isdir(PROJECTS_DIR):
        return False, f"{PROJECTS_DIR} does not exist", fix
    return True, PROJECTS_DIR, None


def check_transcript_format():
    """Read this pane's own session if it has one, then recent files. A session partway through
    a turn may hold no text yet, so one file with no message proves nothing either way."""
    r = herdr("agent", "list", check=False) if PRIMARY else None
    agents = r.get("agents", []) if isinstance(r, dict) else []
    mine = next((a for a in agents if a["pane_id"] == PRIMARY), None)
    own = transcript(session_id(mine)) if mine else None
    found = glob.glob(os.path.join(glob.escape(PROJECTS_DIR), "*", "*.jsonl"))
    recent = sorted(found, key=os.path.getmtime, reverse=True)[:5]
    trouble = None
    for path in ([own] if own else []) + recent:
        try:
            if message_in(path):
                return True, f"read the last message of {path}", None
        except TranscriptError as e:
            trouble = str(e)
    if trouble:
        return False, trouble, ("update herd. Until then results fall back to the pane's screen, "
                                "and background jobs cannot be seen")
    return None, "no finished transcripts yet, so there is nothing to check", None


def probe():
    """Open a throwaway Claude pane and read it, sending no prompt, so it costs no tokens and
    leaves no transcript. Returns (auto check, input box check) as (ok, detail, fix) tuples."""
    update = "update herd. Until then send refuses without --force"
    name = f"herd-doctor-{os.getpid()}"
    with locked(SPAWN_LOCK):
        pane = split(PRIMARY, rects(PRIMARY)[PRIMARY], os.getcwd())
        try:
            time.sleep(1)
            started = None
            for _ in range(5):
                started = start_claude(name, pane, "auto", None)
                if started or AUTO_REFUSED.search(pane_output(pane)):
                    break
                time.sleep(1)
            if not started:
                tail = pane_output(pane).strip()[-200:]
                return ((False, f"claude did not start with --permission-mode auto: {tail or 'no output'}",
                         f"update Claude Code. spawn falls back to {FALLBACK_MODE} mode until then"),
                        (None, "no Claude pane to read", None))
            if not (session_id(started["agent"]) or startup_session(pane)):
                held = "Claude is held at a startup prompt in this folder, usually folder trust"
                fix = "run this from a folder you have already trusted"
                return (None, f"{held}. {fix}", None), (None, f"{held}. {fix}", None)
            mode = settled_mode(pane)
            draft = has_draft(pane)
        finally:
            herdr("pane", "close", pane, check=False)
    if mode == "auto":
        auto = True, "a test pane started in auto mode", None
    elif mode:
        auto = (False, f"a test pane started in {mode} mode, so auto mode is not available here",
                f"check your plan, model, and any disableAutoMode setting. herd still works: "
                f"spawn says so and runs subagents in {mode} mode, where the user answers approval prompts")
    else:
        auto = False, "could not find the permission mode in a test pane's footer", \
            "update herd. Until then spawn warns that it cannot confirm auto mode"
    if draft is False:
        box = True, "found the empty input box in a test pane", None
    elif draft:
        box = False, "an empty input box reads as holding text, so Claude's colors may have changed", update
    else:
        box = False, "could not find the input box in a test pane, so Claude's screen may have changed", update
    return auto, box


def cmd_doctor(a):
    results = [("python", check_python()), ("herdr", check_herdr()),
               ("claude integration", check_integration()), ("claude", check_claude()),
               ("inside herdr", check_inside()), ("transcript location", check_transcript_root()),
               ("transcript format", check_transcript_format())]
    needed = dict(results)
    skip = None
    if not all(needed[k][0] for k in ("inside herdr", "claude", "herdr")):
        skip = "needs herdr and claude working, see above"
    elif os.environ.get("HERD_CHILD"):
        skip = "a herd subagent cannot open panes, run this from the primary"
    results += zip(("auto mode", "input box"), [(None, skip, None)] * 2 if skip else probe())
    failed = 0
    for label, (ok, detail, fix) in results:
        print(f"{ {True: 'PASS', False: 'FAIL', None: 'SKIP'}[ok] } {label}: {detail}")
        if ok is False:
            failed += 1
            print(f"     fix: {fix}")
    if failed:
        die(f"{failed} of {len(results)} checks failed")
    print("herd is ready")


def main():
    if sys.argv[1:2] != ["doctor"] and (os.environ.get("HERDR_ENV") != "1" or not PRIMARY):
        die("not running inside herdr")
    p = argparse.ArgumentParser(prog="herd")
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("spawn")
    s.add_argument("name")
    s.add_argument("brief", help="task text, or - to read stdin")
    s.add_argument("--model")
    s.add_argument("--mode", default="auto", help="auto (default), manual, acceptEdits, plan")
    s.add_argument("--cwd")
    s.add_argument("--tab", metavar="LABEL", help="run in a tab with this label, shared by agents using the same label")
    s.add_argument("--label", metavar="TEXT", help="label for the pane, default the agent's name")
    s.add_argument("--worktree", nargs="?", const="", metavar="BRANCH",
                   help="run in a git worktree of the --cwd repo on BRANCH (default herd/<name>), reattaching if it exists")
    s.set_defaults(fn=cmd_spawn)
    s = sub.add_parser("send")
    s.add_argument("name")
    s.add_argument("text", help="message text, or - to read stdin")
    s.add_argument("--force", action="store_true")
    s.set_defaults(fn=cmd_send)
    s = sub.add_parser("wrapup")
    s.add_argument("names", nargs="*", help="subagents to wrap up, default all")
    s.add_argument("--force", action="store_true", help="discard any unsent text in a pane, then send")
    s.set_defaults(fn=cmd_wrapup)
    s = sub.add_parser("wait")
    s.add_argument("name")
    s.add_argument("--timeout", type=int, help="milliseconds")
    s.set_defaults(fn=cmd_wait)
    s = sub.add_parser("result")
    s.add_argument("name")
    s.set_defaults(fn=cmd_result)
    s = sub.add_parser("status")
    s.set_defaults(fn=cmd_status)
    s = sub.add_parser("rename")
    s.add_argument("name")
    s.add_argument("label", nargs="?", help="new label for the tab holding this subagent")
    s.add_argument("--pane", metavar="LABEL", help="label this subagent's pane instead, which also works in the primary tab")
    s.set_defaults(fn=cmd_rename)
    s = sub.add_parser("close")
    s.add_argument("names", nargs="*")
    s.add_argument("--all", action="store_true")
    s.add_argument("--force", action="store_true")
    s.set_defaults(fn=cmd_close)
    s = sub.add_parser("resume", help="after a restart: reconcile the registry and list the waits to start")
    s.add_argument("--from", dest="source", metavar="PANE", help="adopt the registry of another pane")
    s.add_argument("--force", action="store_true", help="adopt even if that pane hosts a live agent")
    s.set_defaults(fn=cmd_resume)
    s = sub.add_parser("doctor", help="check that herd can run here, and say how to fix what fails")
    s.set_defaults(fn=cmd_doctor)
    a = p.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
